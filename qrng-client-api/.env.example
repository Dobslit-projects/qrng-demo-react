# ── QRNG Client API — variáveis de ambiente ───────────────────────────────────
# Copie este arquivo para .env e ajuste os valores para seu ambiente.
# Em produção (systemd), configure as variáveis diretamente no arquivo de serviço.
# NUNCA commite o arquivo .env real — ele está no .gitignore.

# Porta em que a API escuta (padrão: 3010)
PORT=3010

# URL do QRNG upstream (FPGA/UFPE)
QRNG_UPSTREAM=http://127.0.0.1:18001

# Caminho do banco SQLite (padrão: ./qrng-tokens.db)
# DB_PATH=/var/data/qrng-tokens.db

# Segredo JWT — gere com: openssl rand -hex 32
# Obrigatório em produção. Se ausente, um valor aleatório é gerado a cada restart
# (invalida todas as sessões existentes).
JWT_SECRET=troque-por-um-valor-gerado-com-openssl-rand-hex-32

# E-mail do primeiro usuário admin.
# O usuário que se cadastrar com este e-mail recebe role=admin automaticamente.
ADMIN_EMAIL=admin@seudominio.com

# ── Limites de requisição ─────────────────────────────────────────────────────

# Tamanho máximo por requisição em bytes (padrão: 1 MiB = 1048576)
# Requisições acima retornam HTTP 413 REQUEST_TOO_LARGE.
MAX_BYTES_PER_REQUEST=1048576

# ── Rate limiting ─────────────────────────────────────────────────────────────

# Máximo de requisições por minuto por IP (global, via express-rate-limit)
RATE_LIMIT_PER_IP_PER_MINUTE=120

# Máximo de requisições por minuto por token de API
RATE_LIMIT_PER_TOKEN_PER_MINUTE=60

# ── Cotas diárias ─────────────────────────────────────────────────────────────

# Cota padrão de requests por dia por token (usada ao criar novos tokens)
# Pode ser ajustada por token individualmente via PATCH /v1/admin/tokens/:id/quota
DAILY_QUOTA_REQUESTS=10000

# Cota máxima de bytes por dia por token (global, aplica a todos os tokens)
# 100 MiB = 104857600
DAILY_QUOTA_BYTES=104857600

# ── Timeout do upstream ───────────────────────────────────────────────────────

# Timeout em ms para chamadas ao QRNG upstream (padrão: 10000 = 10s)
QRNG_REQUEST_TIMEOUT_MS=10000

# ── Observabilidade ───────────────────────────────────────────────────────────

# Token estático para proteger o endpoint GET /metrics (Prometheus).
# Se não definido, o endpoint é acessível sem autenticação.
# Gere com: openssl rand -hex 16
# METRICS_TOKEN=troque-por-valor-aleatorio

# ── Fonte / entropia ──────────────────────────────────────────────────────────

# Bytes pedidos ao broker por byte entregue (padrão 1; 20 só com
# ALLOW_LEGACY_TEXT_UPSTREAM=true). Acima de 1 desperdiça entropia física.
# UPSTREAM_OVERPROVISION_FACTOR=1

# Recusa (503 SOURCE_OFFLINE) quando o broker reporta source_status=offline,
# em vez de servir o que sobrou no buffer. Padrão: ligado; =0 desliga.
# REFUSE_WHEN_SOURCE_OFFLINE=1

# ── Retenção de registros de uso (LGPD) ───────────────────────────────────────
# USAGE_LOG_RETENTION_DAYS=90
# USAGE_LOG_IP_TRUNCATE_AFTER_DAYS=7

# ── Identidade do portal Bongo (doc 155) ─────────────────────────────────────
# A sessão do portal chega no cabeçalho X-Portal-Session e é validada no Bongo
# por introspecção (POST $BONGO_INTERNAL_URL/api/internal/v1/introspect). O
# mesmo endereço recebe os e-mails (POST /api/internal/v1/mail).
# BONGO_INTERNAL_URL=http://127.0.0.1:3101
# Segredo compartilhado com o Bongo (o MESMO valor nos dois serviços). Sem ele,
# a sessão do portal responde 503 IDENTITY_UNAVAILABLE (falha fechada) e os
# e-mails de recuperação não são enfileirados; chave de API e login legado
# continuam funcionando. Gere com: openssl rand -hex 32
# INTERNAL_SERVICE_TOKEN=
# Prazo da introspecção e do enfileiramento de e-mail (ms)
# PORTAL_INTROSPECTION_TIMEOUT_MS=3000
# Cache da introspecção (ms), indexado pelo SHA-256 do token; 0 = sem cache.
# Uma sessão revogada no portal cai aqui em no máximo este tempo.
# PORTAL_INTROSPECTION_CACHE_MS=30000
# Estado da conta do portal por trás das chaves de API das contas CRIADAS PELO
# PORTAL (desabilitada / sem qrng / excluída → 403 PORTAL_ACCESS_REVOKED), em
# cache por este tempo (ms). Bongo fora: vale o último estado conhecido.
# PORTAL_ACCOUNT_STATUS_CACHE_MS=60000
# Cópia consistente do banco antes de migrar (padrão ligado); "off" só se a
# cópia já foi feita por fora.
# MIGRATION_BACKUP=

# ── Recuperação de senha das contas antigas (e-mail e senha da API) ──────────
# DESLIGADA por padrão: só ligue (=1) depois de o envio real de e-mail do Bongo
# estar ativo e testado. Desligada, o pedido responde 503
# PASSWORD_RESET_UNAVAILABLE e a tela orienta o contato com o suporte.
# QRNG_PASSWORD_RESET_ENABLED=0
# Validade do link (minutos)
# QRNG_RESET_TOKEN_TTL_MINUTES=30
# Página PÚBLICA do portal (fora do gate de /qrng/) que lê o token do fragmento
# (#token=...) e chama /qrng/v1/auth/password-reset/*. Precisa começar com o
# PUBLIC_BASE_URL do Bongo (o Bongo recusa links de outro domínio).
# QRNG_PASSWORD_RESET_URL=https://bongo.dobslit.com/redefinir-senha-api

# ── Auditoria ────────────────────────────────────────────────────────────────
# Chave HMAC do pseudônimo de e-mail (subject_hash) em eventos de falha/anônimos.
# Sem ela, subject_hash fica NULL. Gere com: openssl rand -hex 32
# AUDIT_PSEUDONYM_KEY=
# AUDIT_RETENTION_DAYS=365
